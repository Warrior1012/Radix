# RADIX Talent Match - copy to backend/.env and fill keys locally.
# Never commit backend/.env or put API keys in frontend variables.

# AI providers (use whichever keys you have; fallback order below)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
# OpenRouter can route to an available free model. Free variants are rate-limited.
OPENROUTER_MODELS=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173

# Resume parser tries one configured model per provider in this order, then keyword fallback if enabled.
RESUME_PROVIDER_ORDER=gemini,groq,openrouter
RESUME_MAX_PROVIDER_ATTEMPTS=3
# Skill Matching uses AI only to suggest evidence-grounded equivalences; score remains deterministic.
AI_SEMANTIC_MATCHING=true
SKILL_MATCH_PROVIDER_ORDER=groq,gemini,openrouter

# Profile Builder offers a read-only AI review; it never rewrites candidate data.
AI_PROFILE_REVIEW=true
PROFILE_REVIEW_PROVIDER_ORDER=gemini,groq,openrouter

# Talent Check uses AI for advisory readiness coaching only. The benchmark score remains deterministic.
AI_TALENT_COACHING=true
TALENT_COACH_PROVIDER_ORDER=gemini,groq,openrouter
MODEL_TIMEOUT_SECONDS=35

# Fallback is labelled as keyword-only/non-AI. Keep false for honest AI-only testing;
# set true only if you want an explicitly labelled demo keyword result after all APIs fail.
DEMO_FALLBACK=false
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase persistence. Never expose the service-role key in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
